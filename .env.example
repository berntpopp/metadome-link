# metadome-link configuration
#
# Copy to .env and edit. All variables use the METADOME_LINK_ prefix.
# Nested settings use a double-underscore delimiter (e.g. METADOME_LINK_METADOME__BASE_URL).

# --- Server ---
METADOME_LINK_HOST=0.0.0.0
METADOME_LINK_PORT=8000
# transport: unified | http | stdio
METADOME_LINK_TRANSPORT=unified
METADOME_LINK_MCP_PATH=/mcp
METADOME_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
METADOME_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
METADOME_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
METADOME_LINK_LOG_LEVEL=INFO
# log_format: json | console
METADOME_LINK_LOG_FORMAT=console

# --- MetaDome upstream (nested: metadome) ---
METADOME_LINK_METADOME__BASE_URL=https://stuart.radboudumc.nl/metadome/api
METADOME_LINK_METADOME__REQUEST_TIMEOUT_S=30.0
METADOME_LINK_METADOME__POLL_SOFT_DEADLINE_S=20.0
METADOME_LINK_METADOME__POLL_INITIAL_INTERVAL_S=2.0
METADOME_LINK_METADOME__POLL_MAX_INTERVAL_S=8.0
METADOME_LINK_METADOME__POLITENESS_RATE_PER_S=3.0
METADOME_LINK_METADOME__POLITENESS_BURST=5
METADOME_LINK_METADOME__MAX_RETRIES=3

# --- Result cache (nested: cache) ---
METADOME_LINK_CACHE__DB_PATH=data/metadome_cache.sqlite
METADOME_LINK_CACHE__TTL_TRANSCRIPTS_S=21600
METADOME_LINK_CACHE__LRU_RESULTS=64
METADOME_LINK_CACHE__LRU_TRANSCRIPTS=256
