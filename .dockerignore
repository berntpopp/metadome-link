# Keep the build context small and the image clean. metadome-link is a pure
# API proxy with no pre-built data — the image only needs the Python package
# and its runtime dependencies.

# Virtualenvs
.venv
venv

# Python caches / build artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
dist
build

# Local data store (SQLite result cache — built at runtime, not shipped in image)
*.sqlite
*.sqlite-*
data

# Tests, docs, and coverage output (not needed in the runtime image)
tests
docs
htmlcov
.coverage
coverage.xml

# Tool caches
.mypy_cache
.ruff_cache
.pytest_cache

# VCS and local env
.git
.gitignore
.env
.env.*
!.env.docker.example

# CI / editor metadata
.github
.pre-commit-config.yaml

# Temporary captures and superpowers docs
/tmp
.superpowers
