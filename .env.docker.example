# Example Docker environment for metadome-link.
# Copy to .env.docker and edit for Compose deployments:
#
#   cp .env.docker.example .env.docker
#
# All keys are optional (the image and docker-compose.yml carry safe defaults).
# metadome-link uses the METADOME_LINK_ prefix; nested settings use __ as
# delimiter (e.g. METADOME_LINK_CACHE__DB_PATH for cache.db_path).

# ---- Server / transport ----
# Transport mode: "unified" serves FastAPI /health + MCP /mcp on one port.
# METADOME_LINK_TRANSPORT=unified
METADOME_LINK_HOST=0.0.0.0
METADOME_LINK_PORT=8000

# ---- MCP path ----
# METADOME_LINK_MCP_PATH=/mcp
METADOME_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1","metadome-link.genefoundry.org"]'
METADOME_LINK_ALLOWED_ORIGINS='["https://metadome-link.genefoundry.org"]'
METADOME_LINK_CORS_ORIGINS='["https://metadome-link.genefoundry.org"]'

# ---- Cache (SQLite result cache) ----
# Path to the on-disk SQLite result cache inside the container.
# Mount /app/data as a named volume to persist across restarts.
METADOME_LINK_CACHE__DB_PATH=/app/data/metadome_cache.sqlite

# ---- MetaDome upstream API ----
# Base URL for the MetaDome web API. Change only if using a mirror.
# METADOME_LINK_METADOME__BASE_URL=https://stuart.radboudumc.nl/metadome/api

# Timeout for individual upstream HTTP requests (seconds).
# METADOME_LINK_METADOME__REQUEST_TIMEOUT_S=30.0

# Soft deadline for the poll_until_ready loop (seconds).
# A landscape that is still building at this deadline gets status "processing".
# METADOME_LINK_METADOME__POLL_SOFT_DEADLINE_S=20.0

# ---- Logging ----
# Renderer for structlog: "json" in production, "console" in dev.
METADOME_LINK_LOG_FORMAT=json
# METADOME_LINK_LOG_LEVEL=INFO

# ---- Local published host port (docker-compose.yml) ----
# Container-internal port stays 8000; override the published host port here to
# avoid clashing with sibling *-link servers on the same host.
# METADOME_LINK_HOST_PORT=8000

# ---- NPM overlay resource limits ----
# METADOME_API_MEMORY_LIMIT=512m
# METADOME_API_CPU_LIMIT=1.0
# NPM_SHARED_NETWORK_NAME=npm_default
